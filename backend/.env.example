# Ollama Configuration (Recommended - no API key needed)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite

# IBM Watson Configuration (Alternative - requires API key)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-1-8b-instruct
GRANITE_EMBEDDING_MODEL=ibm/granite-embedding-30m-english

# Server Configuration
CORS_ORIGINS=http://localhost:3000
